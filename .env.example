# Local development configuration. Copy to .env.
#
# Nothing secret belongs in this file or in this repository. The one
# real secret in the whole system is the
# DKIM private key, and it never comes near postbud: it lives on the
# Postfix host and is applied by OpenDKIM on the way out.

# Postgres. Local dev database; production supplies its own out of band.
DATABASE_URL=postgres://postbud:postbud@localhost:5434/postbud

# HTTP API bind address. 8088 rather than 8080 for local development:
# 8080 is a busy port on a machine that also runs pgadmin.
BIND_ADDR=127.0.0.1:8088

# The Postfix smarthost postbud relays through. In production this is the
# mail VM's address on the tailnet -- never its public address, and never
# a hostname that resolves differently inside and outside the cluster.
RELAY_HOST=127.0.0.1
RELAY_PORT=25
# starttls | tls | none. `none` is defensible only on a private network
# (the tailnet); it is the default for local development against a
# throwaway Postfix or MailHog.
RELAY_TLS=none
# Optional SASL credentials. Omit both when the relay authenticates by
# network location instead (the tailnet case).
#RELAY_USERNAME=
#RELAY_PASSWORD=

# The relay's PUBLIC name — what the world resolves, and what its PTR must
# point back to. Deliberately separate from RELAY_HOST, which is the
# private address mail is submitted through. Unset means the relay
# identity check is off; the admin UI says so rather than showing a tick.
#RELAY_PUBLIC_HOST=mail.example.com

# How many messages one worker claims per tick, and how many of those it
# relays at once. Concurrency is what drains a burst — a claimed batch used
# to go out strictly one message at a time. The SMTP connection pool is
# sized from the same number.
WORKER_BATCH=20
WORKER_CONCURRENCY=8

# The idle wait. Only a safety net now: a newly accepted message wakes the
# worker through a NOTIFY inside the accepting transaction. This interval
# is what catches retries, whose due time nothing can announce in advance.
WORKER_IDLE_MS=2000

# Pool ceiling per process. Must clear WORKER_CONCURRENCY + 1 in the
# worker: one connection is held for the whole process lifetime by the
# queue-notification listener. All processes together must stay under
# Postgres's own max_connections.
#DATABASE_MAX_CONNECTIONS=8

# Message bodies are personal data (invoices carry names, addresses and
# amounts). They are purged this many days after the message reaches a
# terminal state; the delivery record itself is kept.
BODY_RETENTION_DAYS=30

# Token for the admin surface at /admin. Separate from the tenant keys on
# purpose: an admin mints and revokes tenant keys, a strictly greater
# privilege than holding one. Unset = the surface is off (honest 503).
# Production sets this out of band; this local value is not a secret.
ADMIN_TOKEN=local-dev-admin

# OIDC login for /admin (optional; the token above keeps working as the
# break-glass path). postbud is a relying party against ANY OIDC issuer;
# the issuer owns accounts and passwords, postbud owns authorization:
# ADMIN_OIDC_USERS is a comma-separated allowlist of emails and/or
# subject ids. All three must be set together (fail-closed at startup).
#ADMIN_OIDC_ISSUER=https://id.example.com
#ADMIN_OIDC_CLIENT_ID=postbud-admin
#ADMIN_OIDC_USERS=admin@example.com
# Optional: confidential client secret (public PKCE clients need none),
# and a static JWKS file for dev/tests (skips discovery + network).
#ADMIN_OIDC_CLIENT_SECRET=
#ADMIN_OIDC_JWKS_FILE=

# Default SPF for newly registered sending domains (Domains section).
# Unset = every registration must state its SPF explicitly.
#DNS_SPF_DEFAULT=v=spf1 ip4:203.0.113.5 -all

# Resolvers the domain checks query. Default: Cloudflare + Google —
# deliberately NOT the host's, whose ISP resolver may serve a stale
# NXDOMAIN for a domain whose records are already live. Comma-separated
# IPs, or `system` to use /etc/resolv.conf.
#DNS_RESOLVERS=1.1.1.1,8.8.8.8

# The mailbox DMARC aggregate reports arrive in, read by the worker.
# Unset means the poller does not run at all; setting the host without the
# credentials fails at startup rather than skipping quietly. Reports are
# read-only evidence -- nothing fetched here can suppress an address or
# change a domain's status.
#DMARC_EMAIL_IMAP=imap.example.com
#DMARC_EMAIL_USERNAME=reports
#DMARC_EMAIL_PASSWORD=
# The address the rua= tag points at. Documentation only: the poller
# authenticates as DMARC_EMAIL_USERNAME.
#DMARC_EMAIL_ADDRESS=dmarc@example.com
# Defaults: 993, INBOX, Archive, hourly. EVERY message is examined and
# then moved out of the inbox -- leaving it is what marks a message
# handled, not the read flag, so a human opening the mailbox in a mail
# client cannot starve the poller. Unreadable ones go to
# DMARC_EMAIL_FAILURES, which defaults to the archive folder; both are
# created if missing.
#DMARC_EMAIL_PORT=993
#DMARC_EMAIL_MAILBOX=INBOX
#DMARC_EMAIL_ARCHIVE=Archive
#DMARC_EMAIL_FAILURES=Archive
#DMARC_EMAIL_INTERVAL=3600

# Local part of the SMTP envelope sender, per sending domain: a message
# from no-reply@example.com leaves with MAIL FROM:<bounces@example.com>
# while the From: header is untouched. This is what routes DSNs back to
# postbud instead of to whoever reads the From: address, so the address
# must exist on the relay and be routed to the bounce pipe (see
# docs/postfix/virtual.sample). Set it EMPTY to let the envelope follow
# From: -- the old behaviour, and the right choice only for a relay that
# cannot accept a bounces@ address, since a receiver that verifies the
# envelope sender would reject mail from one that does not resolve.
#BOUNCE_MAILBOX=bounces
