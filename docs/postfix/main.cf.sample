# Postfix on the relay VM.
#
# This host does one job: hold the IP reputation and put mail on the wire.
# It has no database, no application code and no state worth backing up
# beyond /etc/postfix and the DKIM key. postbud, in the k3s cluster, owns
# the queue, the suppression list and the delivery record.
#
# NOT a drop-in file -- read it, adapt the marked values, and check
# `postconf -n` against it afterwards.

# ---------------------------------------------------------------- identity

myhostname = mail.example.com
mydomain = example.com
myorigin = $mydomain

# The HELO name must match the PTR record, and the PTR must resolve back to
# this name. Forward-confirmed reverse DNS is the cheapest reputation signal
# there is, and the most commonly missed.
smtp_helo_name = mail.example.com

# ------------------------------------------------------------ IPv4 only
#
# An IPv6 delivery from an address without its own FCrDNS is worse than no
# IPv6 at all: Gmail rejects outright on missing reverse DNS over v6 where
# it would merely have scored it over v4. Turn this on only once the v6
# PTR is in place and verified.
inet_protocols = ipv4

# --------------------------------------------------- who may inject mail
#
# The network postbud's delivery worker submits from, and nothing else.
# This is the whole access-control model of the relay: only the worker
# may inject mail, so every message on the wire has passed the API -- the
# suppression list, the dedup, the delivery record. Do NOT add a wider
# range (a VPN, an office network) for convenience: any machine on it
# could then relay directly and bypass all of that.
#
# Replace with the worker's actual CIDR. Never 0.0.0.0/0, not even
# "temporarily".
mynetworks = 127.0.0.0/8, 10.42.0.0/16

smtpd_relay_restrictions =
    permit_mynetworks
    reject_unauth_destination

# This host has no local users and no mailboxes. It relays for its own
# networks and accepts bounces for its own domain; nothing else.
mydestination = $myhostname, localhost
local_recipient_maps =

# ---------------------------------------------------------- outbound TLS
#
# Opportunistic: encrypt when the far end offers it, deliver anyway when it
# does not. `encrypt` would be stricter and would also silently stop mail
# to correspondents with broken TLS -- the wrong trade for transactional
# mail that must arrive.
smtp_tls_security_level = may
smtp_tls_loglevel = 1
smtp_tls_CApath = /etc/ssl/certs
# `btree:` needs Berkeley DB, which Debian has and Alpine does not. On a
# build without it, tlsmgr logs an error and the cache simply does not
# work -- TLS still negotiates, it just renegotiates every time, which is
# invisible until you look. `lmdb:` is the alternative Postfix names for
# this case; check `postconf -m` for what your build supports.
smtp_tls_session_cache_database = btree:${data_directory}/smtp_scache

# ------------------------------------------------------------- inbound TLS
smtpd_tls_security_level = may
smtpd_tls_cert_file = /etc/letsencrypt/live/mail.example.com/fullchain.pem
smtpd_tls_key_file = /etc/letsencrypt/live/mail.example.com/privkey.pem

# ----------------------------------------------------------------- DKIM
#
# OpenDKIM as a milter. The private key lives here and ONLY here -- not in
# this repository, not in postbud, not in any Kubernetes secret.
milter_default_action = accept
milter_protocol = 6
smtpd_milters = inet:127.0.0.1:8891
non_smtpd_milters = inet:127.0.0.1:8891

# ------------------------------------------------------- bounce handling
#
# Everything the world sends us that we actually want lands in one of these
# addresses; see virtual.sample. Everything else is rejected at RCPT time,
# before any content is accepted -- which is why this host needs no
# antivirus and no spam filter, and fits in 2 GB with room to spare.
virtual_alias_maps = hash:/etc/postfix/virtual

# Postfix's own bounces come back to this address, and the pipe transport in
# master.cf hands them to postbud.
notify_classes = resource, software

# If postbud-bounce is told where to POST by environment variable rather
# than by its defaults, BOTH of these lists must name the variables, and
# setting only export_environment silently does nothing:
#
#   import_environment  what the master KEEPS from the environment it was
#                       started with; anything unlisted is discarded at
#                       startup, so it never survives to be exported.
#   export_environment  what daemons pass to child processes such as a
#                       pipe transport.
#
# Get it wrong and the script starts without them, falls back to a path
# that does not exist, and every bounce DEFERS rather than failing --
# exit 75 requeues instead of losing it, so the queue fills quietly and
# the suppression list learns nothing.
#
# import_environment = $import_environment POSTBUD_URL POSTBUD_BOUNCE_TOKEN_FILE
# export_environment = $export_environment POSTBUD_URL POSTBUD_BOUNCE_TOKEN_FILE

# --------------------------------------------------------------- limits
#
# Small on purpose. This relay serves two applications sending a few
# hundred messages a day; a large default concurrency against an unknown
# receiver looks like a burst and is scored accordingly.
default_destination_concurrency_limit = 5
smtp_destination_rate_delay = 1s

# Hold a connection open long enough to send the NEXT message over it.
#
# Postfix defaults both of these to 2s, which for spread-out transactional
# mail means never: a fresh TCP and TLS handshake per message. Measured on
# a live relay, 53 deliveries to one receiver cost 83 handshakes and zero
# reuse. `smtp_destination_rate_delay` above makes it worse by pinning
# per-destination concurrency to 1, so on-demand caching never sees a
# destination busy enough to start caching.
#
# Hygiene rather than a fix for anything: when a receiver did rate-limit
# this relay, connection count turned out NOT to be the cause -- see
# minimal_backoff_time below for what was.
#
# BOTH are needed. `connection_cache_ttl_limit` is the cap the scache
# server enforces; raising only the smtp-side value is silently clamped
# back down to it.
connection_cache_ttl_limit = 30s
smtp_connection_cache_time_limit = 30s
# Wait long enough after a 4xx.
#
# Postfix defaults to 300s. A receiver that rate-limited this relay
# explained the consequence directly: they expect a sender to wait
# 15-60 minutes after a temporary rejection, "standarden sier enten 30
# eller 60 minutter", and retrying faster triggers an automatic back-off
# that escalates. That is what turned a soft 451 into every packet being
# dropped for two hours -- not volume, and not connection count.
#
# The cost is honest: a message whose first attempt defers now waits half
# an hour rather than five minutes. Against a receiver that stops
# answering entirely, that is the cheaper of the two.
#
# Worth knowing for any new relay: receivers apply this most strictly to
# an IP with no sending history, and some refuse new addresses for
# months. A slow warm-up is expected, not optional.
minimal_backoff_time = 1800s

maximal_queue_lifetime = 1d
bounce_queue_lifetime = 1d
message_size_limit = 26214400
