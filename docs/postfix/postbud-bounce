#!/bin/sh
# /usr/local/bin/postbud-bounce -- invoked by Postfix's pipe transport.
#
# Reads a raw DSN on stdin and posts it to postbud's ingest endpoint.
#
# HTTP rather than a CLI invocation, deliberately: the relay holds no
# database credentials, no schema knowledge, and no binary that has to
# stay in step with the deployment. All it needs is a token and a URL.
#
# Exit codes matter here. Postfix reads them as delivery outcomes, so a
# non-zero exit REQUEUES the DSN rather than losing it -- which is what we
# want when postbud or the network is briefly down. Never `exit 0` on
# failure: that would tell Postfix the bounce was handled and throw away
# the only copy.
#
# 75 = EX_TEMPFAIL, which Postfix treats as "try again later".
set -eu

RAW=$(cat)
[ -n "$RAW" ] || { echo "postbud-bounce: empty input" >&2; exit 75; }

TOKEN=$(cat "${POSTBUD_BOUNCE_TOKEN_FILE:-/etc/postbud-bounce.token}") || exit 75
URL="${POSTBUD_URL:-http://127.0.0.1:30080}"

printf '%s' "$RAW" | curl -sf --max-time 20 -X POST \
    -H "Authorization: Bearer $TOKEN" \
    -H 'Content-Type: message/rfc822' \
    --data-binary @- "$URL/v1/bounces" >/dev/null 2>&1 || exit 75
