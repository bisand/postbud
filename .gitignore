# Generated by Cargo
debug
target

# Local environment (contains DATABASE_URL and RELAY_HOST)
.env
.env.*
!.env.example

# Local dev database
.dev/

# Admin UI toolchain. dist/ is NOT ignored: it is checked in and embedded
# into the binary, so cargo never needs node.
ui/admin/node_modules/

# macOS
.DS_Store

# rustfmt backups
**/*.rs.bk

# Local copies of cluster Secrets. Never committable -- see
# scripts/secrets-sync.sh, which refuses to write anywhere not ignored.
secrets/
